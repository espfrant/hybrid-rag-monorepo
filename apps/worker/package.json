{
  "name": "@rag/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion-worker.d.ts",
      "import": "./dist/ingestion-worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run src",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@rag/cache": "workspace:*",
    "@rag/db": "workspace:*",
    "@rag/embeddings": "workspace:*",
    "@rag/events": "workspace:*",
    "@rag/search": "workspace:*",
    "@rag/shared-types": "workspace:*",
    "pdf-parse": "^2.4.5",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.20.8"
  },
  "devDependencies": {
    "@rag/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
