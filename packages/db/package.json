{
  "name": "@rag/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@rag/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@rag/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
